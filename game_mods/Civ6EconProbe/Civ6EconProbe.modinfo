<?xml version="1.0" encoding="utf-8"?>
<Mod id="7d3c2f1a-6b4e-4c1e-9a52-econprobe0001" version="1">
  <Properties>
    <Name>Civ6 Econ Probe</Name>
    <Description>Read-only. Writes the game's own numbers (costs, purchase prices, growth, border growth, tile yields) for the local player to Lua.log at the start of each turn. Changes nothing in the game.</Description>
    <Teaser>Economy numbers to Lua.log</Teaser>
    <Authors>civ6-econ</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <AffectsSavedGames>0</AffectsSavedGames>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="econprobe_ui">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Civ6EconProbe.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="econprobe_files">
      <File>Civ6EconProbe.lua</File>
    </ImportFiles>
  </InGameActions>
  <Files>
    <File>Civ6EconProbe.xml</File>
    <File>Civ6EconProbe.lua</File>
  </Files>
</Mod>
